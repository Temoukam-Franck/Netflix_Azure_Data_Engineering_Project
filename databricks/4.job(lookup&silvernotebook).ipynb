resources:
  jobs:
    job_lookup_silverNotebook:
      name: job_lookup&silverNotebook
      tasks:
        - task_key: Lookup_Notebook
          notebook_task:
            notebook_path: /Workspace/Users/chiedembrenda@yahoo.com/Netflix_Azure_Data_Engineering_Project/databricks/3.LookupNootebook
            source: WORKSPACE
          existing_cluster_id: 0811-163842-5k7obfnl
        - task_key: SilverNotebook
          depends_on:
            - task_key: Lookup_Notebook
          for_each_task:
            inputs: "{{tasks.Lookup_Notebook.values.my_arr}}"
            task:
              task_key: SilverNotebook_iteration
              notebook_task:
                notebook_path: /Workspace/Users/chiedembrenda@yahoo.com/Netflix_Azure_Data_Engineering_Project/databricks/2.silver
                base_parameters:
                  sourcefolder: "{{input.sourcefolder}}"
                  targetfolder: "{{input.targetfolder}}"
                source: WORKSPACE
              existing_cluster_id: 0811-163842-5k7obfnl
      queue:
        enabled: true
      environments:
        - environment_key: Lookup_Notebook_environment
          spec:
            environment_version: "5"
